{
  "name": "pebble-crew",
  "version": "0.7.8-preview.15",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "python3 scripts/build-guide.py && tsc --noEmit && vite build --config vite.client.config.ts && vite build --config vite.web.config.ts && npm run build:owner",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run typecheck:worker && npm run lint && npm run check:ui && npm run format:check && npm test && npm run build",
    "lint": "eslint .",
    "format": "prettier --write packages apps scripts *.config.* README.md docs test .github .prettierrc.json tsconfig.json package.json",
    "format:check": "prettier --check packages apps scripts *.config.* README.md docs test .github .prettierrc.json tsconfig.json package.json",
    "compatibility:audit": "node scripts/audit-hermes-source.mjs",
    "compatibility:gate": "npm run build --silent && node scripts/check-compatibility.mjs",
    "dev": "vite --config vite.web.config.ts",
    "dev:ui-review": "vite --config vite.ui-lab.config.ts",
    "build:ui-review": "vite build --config vite.ui-lab.config.ts",
    "test:ui-review": "npm run build:ui-review && playwright test --config playwright.ui-review.config.ts",
    "preview": "vite preview --config vite.web.config.ts --host 127.0.0.1",
    "test:plugin": "python3 -m unittest discover -s test/plugin -p \"test_*.py\"",
    "test:native": "python3 scripts/fixture/native_smoke.py",
    "serve": "node scripts/serve-static.mjs",
    "package": "npm run build && python3 scripts/package.py",
    "test:avatars": "playwright test --config playwright.avatar.config.ts",
    "test:mobile": "playwright test --config playwright.mobile.config.ts",
    "build:owner": "node scripts/build-owner.mjs",
    "serve:owner": "node apps/owner-node/dist/main.mjs serve",
    "typecheck:worker": "tsc --noEmit -p apps/owner-worker/tsconfig.json",
    "test:owner-worker": "node scripts/test-owner-worker.mjs",
    "test:owner-browser": "node scripts/test-owner-browser.mjs",
    "test:installed-plugin": "node scripts/test-installed-plugin.mjs",
    "check:ui": "node scripts/check-ui-contract.mjs && node scripts/check-system-contract.mjs"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "better-auth": "1.7.10",
    "class-variance-authority": "0.7.1",
    "jose": "6.2.3",
    "kysely": "0.29.6",
    "lucide-react": "1.58.0",
    "motion": "14.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-zoom-pan-pinch": "4.2.0",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  },
  "packageManager": "npm@11.12.1",
  "description": "A self-hosted interface for Hermes Bot Mode.",
  "homepage": "https://pebblecrew.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/enterkey-io/pebble-crew.git"
  }
}
